<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.macvital.helper</string>

	<!-- Path is relative to the app bundle; SMAppService resolves it. -->
	<key>BundleProgram</key>
	<string>Contents/MacOS/com.macvital.helper</string>

	<key>MachServices</key>
	<dict>
		<key>com.macvital.helper</key>
		<true/>
	</dict>

	<!-- Launch on demand only, and exit when idle. The helper should not be
	     resident: it exists for the few seconds a privileged move takes. -->
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>TimeOut</key>
	<integer>30</integer>

	<!-- Ties the daemon to the app in System Settings > Login Items, so the
	     user sees one entry they understand and can revoke. -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.macvital.MacVital</string>
	</array>

	<key>StandardErrorPath</key>
	<string>/var/log/com.macvital.helper.log</string>
</dict>
</plist>
